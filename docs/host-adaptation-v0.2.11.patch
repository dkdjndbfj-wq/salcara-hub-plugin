@@ -0,0 +1,19 @@
+package service
+
+import (
+	"context"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestPublicHubCannotForgeAdministratorRPCProvenance(t *testing.T) {
+	manager := &PluginManager{}
+	for _, path := range []string{"/salcara-hub/_admin/snapshot", "/salcara-hub/_admin/action", "/salcara-hub/_admin/action?accountId=-1"} {
+		request := httptest.NewRequest("POST", "http://example.test"+path, nil)
+		request.Header.Set("X-Salcara-Admin", "true")
+		request.Header.Set("X-Salcara-Account-ID", "-1")
+		if _, err := manager.RoundTripSalcaraHub(context.Background(), request); err == nil {
+			t.Fatal("public request reached administrator forwarding path")
+		}
+	}
+}
diff --git a/backend/internal/service/plugin_hub_integration_test.go b/backend/internal/service/plugin_hub_integration_test.go
new file mode 100644
--- /dev/null
+++ b/backend/internal/service/plugin_hub_integration_test.go
@@ -0,0 +1,200 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"crypto/tls"
+	"encoding/json"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	pluginv1 "github.com/Wei-Shaw/sub2api/pkg/pluginapi/v1"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials"
+	"google.golang.org/grpc/credentials/insecure"
+)
+
+// Set SALCARA_TEST_HUB_PLUGIN_PACKAGE to a locally built .s2plugin to exercise
+// the real host -> gRPC plugin -> Hub HTTP path, not just the in-process Hub.
+func TestSalcaraHubPluginRuntimeIntegration(t *testing.T) {
+	packagePath := os.Getenv("SALCARA_TEST_HUB_PLUGIN_PACKAGE")
+	if packagePath == "" {
+		t.Skip("未提供 SALCARA_TEST_HUB_PLUGIN_PACKAGE")
+	}
+	packageFile, err := os.Open(packagePath)
+	require.NoError(t, err)
+	defer packageFile.Close()
+
+	root := t.TempDir()
+	cfg := testPluginConfig(root, true)
+	// A signed local fixture must pass the same trust check as a release. This
+	// only updates this test's isolated config, never the running host's trust.
+	if publicIdentity := os.Getenv("SALCARA_TEST_PUBLIC_IDENTITY"); publicIdentity != "" {
+		publicRaw, readErr := os.ReadFile(publicIdentity)
+		require.NoError(t, readErr)
+		var publisher struct {
+			KeyID     string `json:"key_id"`
+			PublicKey string `json:"public_key"`
+		}
+		require.NoError(t, json.Unmarshal(publicRaw, &publisher))
+		require.NotEmpty(t, publisher.KeyID)
+		require.NotEmpty(t, publisher.PublicKey)
+		cfg.Plugins.AllowUnsigned = false
+		cfg.Plugins.TrustedPublishers[publisher.KeyID] = publisher.PublicKey
+	}
+	installer := NewPluginPackageInstaller(cfg, PluginHostInfo{Version: "0.2.11+salcara.hub.1", BuildType: "experimental"})
+	installation, err := installer.Install(context.Background(), packageFile, nil)
+	require.NoError(t, err)
+	require.Equal(t, PluginCapabilitySalcaraHubHTTP, installation.Manifest.Capabilities[0].ID)
+
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/v1/salcara-hub/key" {
+			http.NotFound(w, r)
+			return
+		}
+		switch r.Header.Get("Authorization") {
+		case "Bearer sk-allowed":
+			_, _ = io.WriteString(w, `{"group_id":7}`)
+		case "Bearer sk-denied":
+			_, _ = io.WriteString(w, `{"group_id":8}`)
+		default:
+			w.WriteHeader(http.StatusUnauthorized)
+		}
+	}))
+	defer upstream.Close()
+
+	runtime, err := startPluginRuntime(context.Background(), installation, 15*time.Second, filepath.Join(root, "runtime"), nil)
+	require.NoError(t, err)
+	defer runtime.kill()
+	configJSON, err := json.Marshal(map[string]any{"sub2api_url": upstream.URL, "allowed_group_ids": []int64{7}, "trust_proxy": false, "command_timeout_seconds": 5})
+	require.NoError(t, err)
+	require.NoError(t, runtime.validateAndApplyConfig(context.Background(), configJSON))
+
+	// The real packaged SDK negotiates automatic mTLS with the host. Neither
+	// plaintext nor a TLS client without the per-process client certificate
+	// may impersonate private Forward provenance on the local RPC listener.
+	address, err := runtime.client.Start()
+	require.NoError(t, err)
+	for _, transport := range []struct {
+		name  string
+		creds credentials.TransportCredentials
+	}{
+		{"plaintext", insecure.NewCredentials()},
+		// Server verification is deliberately omitted ONLY for this negative
+		// test: even a client willing to trust any server must be rejected for
+		// lacking the client's certificate. Production never uses this config.
+		{"tls-without-client-certificate", credentials.NewTLS(&tls.Config{InsecureSkipVerify: true, MinVersion: tls.VersionTLS12})},
+	} {
+		t.Run(transport.name, func(t *testing.T) {
+			conn, dialErr := grpc.NewClient("passthrough:///fixture-plugin", grpc.WithTransportCredentials(transport.creds), grpc.WithContextDialer(func(ctx context.Context, _ string) (net.Conn, error) {
+				return (&net.Dialer{}).DialContext(ctx, address.Network(), address.String())
+			}))
+			require.NoError(t, dialErr)
+			defer conn.Close()
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			defer cancel()
+			client := pluginv1.NewTransportPluginClient(conn)
+			_, infoErr := client.GetInfo(ctx, &pluginv1.GetInfoRequest{})
+			require.Error(t, infoErr, "unauthenticated local RPC client accessed the plugin")
+			stream, streamErr := client.Forward(ctx)
+			if streamErr == nil {
+				streamErr = stream.Send(&pluginv1.ForwardRequest{Frame: &pluginv1.ForwardRequest_Start{Start: &pluginv1.ForwardRequestStart{Method: "POST", Url: "/salcara-hub/_admin/snapshot", AccountId: -1, Platform: PluginHubPlatform, AccountType: PluginHubAccountType}}})
+				if streamErr == nil {
+					_, streamErr = stream.Recv()
+				}
+			}
+			require.Error(t, streamErr, "unauthenticated client forged private administrator Forward")
+		})
+	}
+
+	roundTrip := func(method, path string, header http.Header, body []byte, admin bool) (int, []byte) {
+		t.Helper()
+		// Match the host's origin-form public/admin forwarding. An absolute
+		// outbound URL is intentionally rejected by the Hub plugin.
+		request, requestErr := http.NewRequest(method, path, bytes.NewReader(body))
+		require.NoError(t, requestErr)
+		request.Header = header
+		if len(body) != 0 && request.Header.Get("Content-Type") == "" {
+			request.Header.Set("Content-Type", "application/json")
+		}
+		account := &Account{Platform: PluginHubPlatform, Type: PluginHubAccountType}
+		if admin {
+			account.ID = -1
+		}
+		require.True(t, runtime.beginRequest())
+		response, roundErr := runtime.roundTrip(context.Background(), request, "", account)
+		if roundErr != nil {
+			runtime.finishRequest()
+		}
+		require.NoError(t, roundErr)
+		responseBody, readErr := io.ReadAll(response.Body)
+		require.NoError(t, readErr)
+		require.NoError(t, response.Body.Close())
+		return response.StatusCode, responseBody
+	}
+	status, _ := roundTrip(http.MethodPost, "/salcara-hub/_admin/snapshot", http.Header{}, []byte(`{}`), false)
+	require.Equal(t, http.StatusForbidden, status)
+	status, body := roundTrip(http.MethodPost, "/salcara-hub/v1/device/register", http.Header{"X-Salcara-Device-Id": {"runtime-fixture-pc"}, "X-Salcara-Device-Secret": {"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}}, []byte(`{"deviceId":"runtime-fixture-pc","name":"Runtime fixture"}`), false)
+	require.Equal(t, http.StatusOK, status, string(body))
+	status, body = roundTrip(http.MethodPost, "/salcara-hub/_admin/snapshot", http.Header{}, []byte(`{}`), true)
+	require.Equal(t, http.StatusOK, status, string(body))
+	var snapshot struct {
+		Devices []struct {
+			Ref string `json:"ref"`
+		}
+		Stats struct {
+			Banned int `json:"banned_devices"`
+		}
+	}
+	require.NoError(t, json.Unmarshal(body, &snapshot))
+	require.Len(t, snapshot.Devices, 1)
+	banBody, err := json.Marshal(map[string]string{"action": "ban", "ref": snapshot.Devices[0].Ref, "reason": "Local runtime fixture", "actor": "host-admin:42"})
+	require.NoError(t, err)
+	status, body = roundTrip(http.MethodPost, "/salcara-hub/_admin/action", http.Header{}, banBody, true)
+	require.Equal(t, http.StatusOK, status, string(body))
+	status, _ = roundTrip(http.MethodPost, "/salcara-hub/v1/device/register", http.Header{"X-Salcara-Device-Id": {"runtime-fixture-pc"}, "X-Salcara-Device-Secret": {"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}}, []byte(`{"deviceId":"runtime-fixture-pc"}`), false)
+	require.Equal(t, http.StatusForbidden, status)
+
+	call := func(path, key string) int {
+		t.Helper()
+		parsed, parseErr := url.ParseRequestURI(path)
+		require.NoError(t, parseErr)
+		request := &http.Request{Method: http.MethodGet, URL: parsed, Host: "example.com", Header: make(http.Header), Body: http.NoBody}
+		if key != "" {
+			request.Header.Set("Authorization", "Bearer "+key)
+		}
+		require.True(t, runtime.beginRequest())
+		response, roundErr := runtime.roundTrip(context.Background(), request, "", &Account{Platform: PluginHubPlatform, Type: PluginHubAccountType})
+		if roundErr != nil {
+			runtime.finishRequest()
+		}
+		require.NoError(t, roundErr)
+		_, readErr := io.Copy(io.Discard, response.Body)
+		require.NoError(t, readErr)
+		require.NoError(t, response.Body.Close())
+		return response.StatusCode
+	}
+	require.Equal(t, http.StatusOK, call("/salcara-hub/v1/ping", ""))
+	require.Equal(t, http.StatusOK, call("/salcara-hub/v1/me", "sk-allowed"))
+	require.Equal(t, http.StatusForbidden, call("/salcara-hub/v1/me", "sk-denied"))
+	require.Equal(t, http.StatusForbidden, call("/salcara-hub/v1/app/devices", "sk-allowed"))
+
+	// A saved allowlist change must take effect immediately, without reusing the
+	// old Hub's successful key cache or allowing a removed group to reconnect.
+	changedConfig, err := json.Marshal(map[string]any{"sub2api_url": upstream.URL, "allowed_group_ids": []int64{8}, "trust_proxy": false, "command_timeout_seconds": 5})
+	require.NoError(t, err)
+	require.NoError(t, runtime.validateAndApplyConfig(context.Background(), changedConfig))
+	// Replacement Hub must load the ban committed by the prior private RPC.
+	status, _ = roundTrip(http.MethodPost, "/salcara-hub/v1/device/register", http.Header{"X-Salcara-Device-Id": {"runtime-fixture-pc"}, "X-Salcara-Device-Secret": {"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}}, []byte(`{"deviceId":"runtime-fixture-pc"}`), false)
+	require.Equal(t, http.StatusForbidden, status)
+	require.Equal(t, http.StatusForbidden, call("/salcara-hub/v1/me", "sk-allowed"))
+	require.Equal(t, http.StatusOK, call("/salcara-hub/v1/me", "sk-denied"))
+}
