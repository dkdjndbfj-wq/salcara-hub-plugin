+package service
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestPluginManifestSalcaraHubCapabilityIsExplicitAndIsolated(t *testing.T) {
+	manifest := testPluginManifest(nil)
+	manifest.Capabilities = []PluginCapability{{
+		ID: PluginCapabilitySalcaraHubHTTP, Platform: PluginHubPlatform, AccountType: PluginHubAccountType,
+	}}
+	require.NoError(t, manifest.Validate())
+
+	// A Hub cannot acquire the OAuth account-directory privileges just by using
+	// an OAuth platform tuple, nor can it declare both capabilities at once.
+	manifest.Capabilities[0].Platform = PlatformOpenAI
+	manifest.Capabilities[0].AccountType = AccountTypeOAuth
+	require.ErrorContains(t, manifest.Validate(), "签名或添加发布者信任不能补齐宿主能力")
+	manifest.Capabilities[0].Platform = PluginHubPlatform
+	manifest.Capabilities[0].AccountType = PluginHubAccountType
+	manifest.Capabilities = append(manifest.Capabilities, PluginCapability{
+		ID: PluginCapabilityOpenAIOAuthOutbound, Platform: PlatformOpenAI, AccountType: AccountTypeOAuth,
+	})
+	require.ErrorContains(t, manifest.Validate(), "必须且只能声明一个能力")
+}
+
+func TestPluginManifestUnknownCapabilityRequiresHostAdapterNotSignature(t *testing.T) {
+	manifest := testPluginManifest(nil)
+	manifest.Capabilities[0].ID = "example.unknown.v1"
+	err := manifest.Validate()
+	require.ErrorContains(t, err, "当前宿主不支持插件能力 example.unknown.v1")
+	require.ErrorContains(t, err, "签名或添加发布者信任不能补齐宿主能力")
+}
