+package repository
+
+import (
+	"context"
+	"database/sql"
+	"regexp"
+	"testing"
+
+	"github.com/DATA-DOG/go-sqlmock"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/stretchr/testify/require"
+)
+
+func updateCASFixture() *service.PluginInstallation {
+	return &service.PluginInstallation{ID: 7, PluginKey: "top.salcara.hub", Version: "0.3.1",
+		BinarySHA256: "same-runtime-binary", ConfigEncrypted: "existing-ciphertext", State: service.PluginStateEnabled}
+}
+
+func TestPluginUpdateRepositoryStopCASDoesNotDisableConcurrentReplacement(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	defer db.Close()
+	previous := updateCASFixture()
+	mock.ExpectBegin()
+	mock.ExpectExec(`(?s)UPDATE sub2api_plugin_installations.*WHERE id=\$1 AND plugin_key=\$2 AND version=\$3 AND binary_sha256=\$4\s+AND config_encrypted=\$5 AND state=\$6`).
+		WithArgs(previous.ID, previous.PluginKey, previous.Version, previous.BinarySHA256, previous.ConfigEncrypted, previous.State).
+		WillReturnResult(sqlmock.NewResult(0, 0))
+	mock.ExpectRollback()
+	err = (&pluginRepository{db: db}).StopForUpdate(context.Background(), previous, nil)
+	require.ErrorIs(t, err, service.ErrPluginStateChanged)
+	require.NoError(t, mock.ExpectationsWereMet(), "bindings must not be replaced after a failed CAS")
+}
+
+func TestPluginUpdateRepositoryInstallCASDoesNotOverwriteSameBinaryNewVersion(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	defer db.Close()
+	previous, candidate := updateCASFixture(), updateCASFixture()
+	candidate.Version = "0.3.2"
+	mock.ExpectBegin()
+	mock.ExpectQuery(`(?s)UPDATE sub2api_plugin_installations p.*WHERE p.id=\$13 AND p.plugin_key=\$14 AND p.version=\$15 AND p.binary_sha256=\$16\s+AND p.config_encrypted=\$17 AND p.state IN \('disabled','error','incompatible'\).*AND NOT EXISTS.*b.enabled=TRUE`).
+		WithArgs(candidate.Name, candidate.Version, candidate.Description, candidate.Author, sqlmock.AnyArg(), candidate.ArtifactData,
+			candidate.ArtifactPath, candidate.InstallPath, candidate.BinaryPath, candidate.BinarySHA256, candidate.SignatureStatus, candidate.InstalledBy,
+			previous.ID, previous.PluginKey, previous.Version, previous.BinarySHA256, previous.ConfigEncrypted).
+		WillReturnRows(sqlmock.NewRows([]string{"id"}))
+	mock.ExpectRollback()
+	_, err = (&pluginRepository{db: db}).InstallUpdate(context.Background(), previous, candidate, nil)
+	require.ErrorIs(t, err, service.ErrPluginStateChanged)
+	require.NoError(t, mock.ExpectationsWereMet())
+}
+
+func TestPluginUpdateRepositoryResumeCASIncludesVersionAndConfig(t *testing.T) {
+	for _, changed := range []bool{false, true} {
+		t.Run(map[bool]string{false: "unchanged", true: "concurrent-change"}[changed], func(t *testing.T) {
+			db, mock, err := sqlmock.New()
+			require.NoError(t, err)
+			defer db.Close()
+			expected := updateCASFixture()
+			expected.State = service.PluginStateDisabled
+			affected := int64(1)
+			if changed {
+				affected = 0
+			}
+			mock.ExpectExec(regexp.QuoteMeta("WHERE id=$1 AND binary_sha256=$2 AND state=$3 AND version=$4 AND config_encrypted=$5 AND state<>'starting'")).
+				WithArgs(expected.ID, expected.BinarySHA256, expected.State, expected.Version, expected.ConfigEncrypted).
+				WillReturnResult(sqlmock.NewResult(0, affected))
+			err = (&pluginRepository{db: db}).BeginEnableUpdate(context.Background(), expected.ID, expected.BinarySHA256, expected.State, expected.Version, expected.ConfigEncrypted)
+			if changed {
+				require.ErrorIs(t, err, service.ErrPluginStateChanged)
+			} else {
+				require.NoError(t, err)
+			}
+			require.NoError(t, mock.ExpectationsWereMet())
+		})
+	}
+}
+
+func TestPluginUpdateRepositoryFinalCASIsAtomicWithBindings(t *testing.T) {
+	for _, targetState := range []string{service.PluginStateEnabled, service.PluginStateError} {
+		for _, changed := range []bool{false, true} {
+			t.Run(targetState+map[bool]string{false: "-unchanged", true: "-concurrent-change"}[changed], func(t *testing.T) {
+				db, mock, err := sqlmock.New()
+				require.NoError(t, err)
+				defer db.Close()
+				expected := updateCASFixture()
+				affected := int64(1)
+				if changed {
+					affected = 0
+				}
+				mock.ExpectBegin()
+				mock.ExpectExec(regexp.QuoteMeta("WHERE id=$1 AND state='starting' AND version=$5 AND binary_sha256=$6 AND config_encrypted=$7")).
+					WithArgs(expected.ID, targetState, "", (*sql.NullTime)(nil), expected.Version, expected.BinarySHA256, expected.ConfigEncrypted).
+					WillReturnResult(sqlmock.NewResult(0, affected))
+				var bindings []service.PluginBinding
+				if changed {
+					mock.ExpectRollback()
+				} else {
+					if targetState == service.PluginStateEnabled {
+						bindings = []service.PluginBinding{}
+						mock.ExpectExec(regexp.QuoteMeta("DELETE FROM sub2api_plugin_bindings WHERE plugin_id = $1")).WithArgs(expected.ID).
+							WillReturnResult(sqlmock.NewResult(0, 1))
+					}
+					mock.ExpectCommit()
+				}
+				err = (&pluginRepository{db: db}).FinishEnableUpdate(context.Background(), expected, bindings, targetState, "", nil)
+				if changed {
+					require.ErrorIs(t, err, service.ErrPluginStateChanged)
+				} else {
+					require.NoError(t, err)
+				}
+				require.NoError(t, mock.ExpectationsWereMet(), "failed CAS must not modify another installation's bindings")
+			})
+		}
+	}
+}
diff --git a/backend/internal/handler/admin/plugin_update_handler_test.go b/backend/internal/handler/admin/plugin_update_handler_test.go
