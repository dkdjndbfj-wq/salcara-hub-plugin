+package routes
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/handler"
+	"github.com/Wei-Shaw/sub2api/internal/handler/admin"
+	"github.com/Wei-Shaw/sub2api/internal/server/middleware"
+	"github.com/gin-gonic/gin"
+)
+
+func TestHubAdminRoutesRequireHostAdminChainAndStepUpOnActions(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	router := gin.New()
+	group := router.Group("/admin")
+	// This fixture tests route middleware composition, not a live JWT/TOTP UI.
+	group.Use(func(c *gin.Context) {
+		if c.GetHeader("X-Test-Admin-Session") != "valid" {
+			c.AbortWithStatus(http.StatusUnauthorized)
+			return
+		}
+		c.Next()
+	})
+	stepUpCalls := 0
+	stepUp := middleware.StepUpAuthMiddleware(func(c *gin.Context) {
+		stepUpCalls++
+		if c.GetHeader("X-Test-Step-Up") != "valid" {
+			c.AbortWithStatus(http.StatusPreconditionRequired)
+			return
+		}
+		c.Next()
+	})
+	h := &handler.Handlers{Admin: &handler.AdminHandlers{Plugin: admin.NewPluginHandler(nil)}}
+	registerPluginRoutes(group, h, stepUp)
+	call := func(method, path, session, second string) int {
+		r := httptest.NewRequest(method, path, nil)
+		r.Header.Set("X-Test-Admin-Session", session)
+		r.Header.Set("X-Test-Step-Up", second)
+		w := httptest.NewRecorder()
+		router.ServeHTTP(w, r)
+		return w.Code
+	}
+	if code := call("POST", "/admin/plugins/1/hub/action", "", ""); code != 401 || stepUpCalls != 0 {
+		t.Fatal("anonymous request bypassed host admin chain")
+	}
+	if code := call("POST", "/admin/plugins/1/hub/action", "valid", ""); code != 428 || stepUpCalls != 1 {
+		t.Fatal("action bypassed step-up middleware")
+	}
+	if code := call("POST", "/admin/plugins/not-id/hub/action", "valid", "valid"); code != 400 || stepUpCalls != 2 {
+		t.Fatal("accepted step-up did not reach input validation")
+	}
+	if code := call("GET", "/admin/plugins/not-id/hub", "valid", ""); code != 400 || stepUpCalls != 2 {
+		t.Fatal("read-only snapshot should not need step-up")
+	}
+	if code := call("GET", "/admin/plugins/not-id/update", "", ""); code != 401 || stepUpCalls != 2 {
+		t.Fatal("update checks bypassed host admin chain")
+	}
+	if code := call("GET", "/admin/plugins/not-id/update", "valid", ""); code != 400 || stepUpCalls != 2 {
+		t.Fatal("read-only update check should not need step-up")
+	}
+	if code := call("POST", "/admin/plugins/not-id/update", "valid", ""); code != 428 || stepUpCalls != 3 {
+		t.Fatal("update installation bypassed step-up")
+	}
+	if code := call("POST", "/admin/plugins/not-id/update", "valid", "valid"); code != 400 || stepUpCalls != 4 {
+		t.Fatal("accepted update step-up did not reach input validation")
+	}
+}
diff --git a/backend/internal/service/plugin_hub.go b/backend/internal/service/plugin_hub.go
new file mode 100644
--- /dev/null
+++ b/backend/internal/service/plugin_hub.go
@@ -0,0 +1,246 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+)
+
+// installationCapability is deliberately limited to one capability per plugin.
+// This prevents an HTTP-facing Hub plugin from acquiring the account-directory
+// privileges reserved for an outbound OAuth transport plugin.
+func installationCapability(installation *PluginInstallation) string {
+	if installation == nil || len(installation.Manifest.Capabilities) != 1 {
+		return ""
+	}
+	return installation.Manifest.Capabilities[0].ID
+}
+
+func hasEnabledHubBinding(bindings []PluginBinding) bool {
+	for _, binding := range bindings {
+		if binding.Enabled && binding.Capability == PluginCapabilitySalcaraHubHTTP &&
+			binding.Platform == PluginHubPlatform && binding.AccountType == PluginHubAccountType {
+			return true
+		}
+	}
+	return false
+}
+
+// reconcileHubOnce runs under operationMu, alongside the existing OAuth
+// reconciliation. Each capability owns its own route and runtime; neither may
+// drain the other's process.
+func (m *PluginManager) reconcileHubOnce(ctx context.Context, installations []*PluginInstallation) error {
+	var enabled *PluginInstallation
+	for _, installation := range installations {
+		if !hasEnabledHubBinding(installation.Bindings) {
+			continue
+		}
+		if enabled != nil {
+			err := errors.New("检测到多个 Salcara Hub 插件同时启用")
+			m.publishHubUnavailableRoute(enabled.ID, err.Error())
+			return err
+		}
+		enabled = installation
+	}
+	if enabled == nil {
+		for _, installation := range installations {
+			if installationCapability(installation) != PluginCapabilitySalcaraHubHTTP ||
+				installation.State != PluginStateStarting || !m.startingStateExpired(installation) {
+				continue
+			}
+			if err := m.repo.UpdateState(
+				ctx, installation.ID, PluginStateDisabled, "插件启动超时，已自动恢复为停用状态", nil,
+				installation.BinarySHA256, PluginStateStarting,
+			); err != nil && !errors.Is(err, ErrPluginStateChanged) {
+				return fmt.Errorf("恢复超时 Hub 插件状态: %w", err)
+			}
+		}
+		m.mu.Lock()
+		current := m.hubRoute.Swap(nil)
+		var runtime *pluginRuntime
+		if current != nil && current.runtime != nil {
+			runtime = m.runtimes[current.pluginID]
+			delete(m.runtimes, current.pluginID)
+		}
+		m.mu.Unlock()
+		if runtime != nil {
+			runtime.drain(10 * time.Second)
+		}
+		return nil
+	}
+	current := m.hubRoute.Load()
+	if current != nil && current.pluginID == enabled.ID && current.runtime != nil &&
+		!current.runtime.client.Exited() &&
+		current.runtime.installation.BinarySHA256 == enabled.BinarySHA256 &&
+		current.runtime.installation.ConfigEncrypted == enabled.ConfigEncrypted {
+		healthCtx, cancel := context.WithTimeout(ctx, pluginHealthTimeout)
+		healthErr := current.runtime.checkHealth(healthCtx)
+		cancel()
+		if healthErr != nil {
+			_ = m.markRuntimeUnavailable(current, healthErr.Error())
+			return healthErr
+		}
+		if enabled.State == PluginStateError || (enabled.State == PluginStateStarting && m.startingStateExpired(enabled)) {
+			return m.repo.MarkRuntimeHealthy(ctx, enabled.ID, enabled.BinarySHA256, enabled.ConfigEncrypted)
+		}
+		return nil
+	}
+	if enabled.State == PluginStateStarting && !m.startingStateExpired(enabled) {
+		if current == nil {
+			m.hubRoute.Store(&pluginRoute{pluginID: enabled.ID, rolloutPercent: 100, unavailable: "插件正在其他实例中启动"})
+		}
+		return nil
+	}
+	local, err := m.ensureLocalInstallation(ctx, enabled)
+	if err != nil {
+		m.publishHubUnavailableRoute(enabled.ID, err.Error())
+		return err
+	}
+	runtime, err := m.prepareRuntime(ctx, local, true)
+	if err != nil {
+		m.publishHubUnavailableRoute(enabled.ID, err.Error())
+		return err
+	}
+	latest, err := m.repo.GetByID(ctx, enabled.ID)
+	if err != nil {
+		runtime.kill()
+		return err
+	}
+	if !hasEnabledHubBinding(latest.Bindings) || latest.BinarySHA256 != enabled.BinarySHA256 ||
+		latest.ConfigEncrypted != enabled.ConfigEncrypted {
+		runtime.kill()
+		return nil
+	}
+	if latest.State == PluginStateStarting && !m.startingStateExpired(latest) {
+		runtime.kill()
+		return nil
+	}
+	if err := m.repo.MarkRuntimeHealthy(ctx, enabled.ID, enabled.BinarySHA256, enabled.ConfigEncrypted); err != nil {
+		runtime.kill()
+		if errors.Is(err, ErrPluginStateChanged) {
+			return nil
+		}
+		return err
+	}
+	m.mu.Lock()
+	previous := m.hubRoute.Load()
+	if previous != nil && previous.pluginID != enabled.ID {
+		delete(m.runtimes, previous.pluginID)
+	}
+	m.publishRuntimeLocked(enabled, runtime)
+	m.mu.Unlock()
+	if previous != nil && previous.runtime != nil && previous.runtime != runtime {
+		previous.runtime.drain(10 * time.Second)
+	}
+	return nil
+}
+
+func (m *PluginManager) publishHubUnavailableRoute(pluginID int64, message string) {
+	m.mu.Lock()
+	current := m.hubRoute.Load()
+	var stale *pluginRuntime
+	if current != nil && current.runtime != nil {
+		stale = m.runtimes[current.pluginID]
+		delete(m.runtimes, current.pluginID)
+	}
+	m.hubRoute.Store(&pluginRoute{pluginID: pluginID, rolloutPercent: 100, unavailable: message})
+	m.mu.Unlock()
+	if stale != nil {
+		stale.drain(10 * time.Second)
+	}
+}
+
+// RoundTripSalcaraHub forwards a public /salcara-hub request to the enabled
+// plugin. Public requests cannot acquire private administrator provenance.
+func (m *PluginManager) RoundTripSalcaraHub(ctx context.Context, request *http.Request) (*http.Response, error) {
+	if request == nil || request.URL == nil || strings.HasPrefix(request.URL.Path, "/salcara-hub/_admin") {
+		return nil, errors.New("管理接口不允许公网转发")
+	}
+	route := m.hubRoute.Load()
+	if route == nil {
+		return nil, errors.New("Salcara Hub 插件未启用")
+	}
+	if route.runtime == nil {
+		return nil, fmt.Errorf("Salcara Hub 插件不可用: %s", route.unavailable)
+	}
+	if route.runtime.client.Exited() {
+		err := errors.New("Salcara Hub 插件进程已退出")
+		_ = m.markRuntimeUnavailable(route, err.Error())
+		return nil, err
+	}
+	if !route.runtime.beginRequest() {
+		return nil, errors.New("Salcara Hub 插件正在停止")
+	}
+	response, err := route.runtime.roundTrip(ctx, request, "", &Account{Platform: PluginHubPlatform, Type: PluginHubAccountType})
+	if err != nil {
+		route.runtime.finishRequest()
+		if route.runtime.client.Exited() {
+			_ = m.markRuntimeUnavailable(route, err.Error())
+		}
+		return nil, err
+	}
+	return response, nil
+}
+
+// HubAdmin is reachable only from the host's admin JWT/step-up routes. The
+// reserved negative account ID lives in gRPC metadata, not HTTP headers, so
+// public callers cannot forge it. The plugin owns the operation allowlist.
+func (m *PluginManager) HubAdmin(ctx context.Context, id int64, action string, input json.RawMessage) (json.RawMessage, error) {
+	path, method := "/salcara-hub/_admin/snapshot", http.MethodPost
+	if action == "action" {
+		path, method = "/salcara-hub/_admin/action", http.MethodPost
+	} else if action != "snapshot" {
+		return nil, errors.New("Hub 管理接口无效")
+	}
+	if len(input) > 4096 {
+		return nil, errors.New("管理请求过大")
+	}
+	installation, err := m.repo.GetByID(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	if installationCapability(installation) != PluginCapabilitySalcaraHubHTTP || !hasEnabledHubBinding(installation.Bindings) {
+		return nil, errors.New("该插件未启用 Hub 管理能力")
+	}
+	route := m.hubRoute.Load()
+	if route == nil || route.pluginID != id || route.runtime == nil || route.runtime.client.Exited() {
+		return nil, errors.New("Hub 管理服务未就绪")
+	}
+	request, err := http.NewRequestWithContext(ctx, method, path, bytes.NewReader(input))
+	if err != nil {
+		return nil, err
+	}
+	request.Header.Set("Content-Type", "application/json")
+	if !route.runtime.beginRequest() {
+		return nil, errors.New("Hub 插件正在停止")
+	}
+	result, err := route.runtime.roundTrip(ctx, request, "", &Account{ID: -1, Platform: PluginHubPlatform, Type: PluginHubAccountType})
+	if err != nil {
+		route.runtime.finishRequest()
+		return nil, err
+	}
+	defer result.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(result.Body, 8<<20))
+	if err != nil {
+		return nil, errors.New("读取 Hub 管理响应失败")
+	}
+	if result.StatusCode != http.StatusOK {
+		var failure struct {
+			Error string `json:"error"`
+		}
+		if json.Unmarshal(body, &failure) == nil && failure.Error != "" {
+			return nil, errors.New(failure.Error)
+		}
+		return nil, errors.New("Hub 管理请求被拒绝")
+	}
+	if !json.Valid(body) {
+		return nil, errors.New("Hub 管理响应无效")
+	}
+	return body, nil
+}
