+<script setup lang="ts">
+import { ref, watch } from 'vue'
+import { useI18n } from 'vue-i18n'
+import { adminAPI } from '@/api/admin'
+import type { PluginInstallation, PluginUpdateCheck } from '@/api/admin/plugins'
+import { useAppStore } from '@/stores'
+import TotpStepUpDialog from '@/components/auth/TotpStepUpDialog.vue'
+import { isStepUpBlocked, isStepUpCancelled, stepUpBlockReason, useStepUp } from '@/composables/useStepUp'
+
+const props = defineProps<{ plugin: PluginInstallation; disabled?: boolean }>()
+const emit = defineEmits<{ changed: []; busy: [value: boolean] }>()
+const { t } = useI18n()
+const store = useAppStore()
+const stepUp = useStepUp()
+const check = ref<PluginUpdateCheck | null>(null)
+const busy = ref(false)
+
+watch(() => [props.plugin.version, props.plugin.binary_sha256], () => { check.value = null })
+
+function setBusy(value: boolean): void { busy.value = value; emit('busy', value) }
+function reportError(error: unknown): void {
+  if (isStepUpCancelled(error)) return
+  if (isStepUpBlocked(error)) {
+    store.showError(stepUpBlockReason(error) === 'STEP_UP_ADMIN_API_KEY_FORBIDDEN'
+      ? t('stepUp.adminApiKeyForbidden') : t('stepUp.notEnabled'))
+    return
+  }
+  const message = typeof error === 'object' && error !== null && 'message' in error
+    && typeof error.message === 'string' ? error.message : t('common.unknownError')
+  store.showError(message)
+}
+
+async function checkForUpdate(): Promise<void> {
+  if (busy.value || props.disabled) return
+  setBusy(true)
+  check.value = null
+  try { check.value = await adminAPI.plugins.checkUpdate(props.plugin.id) }
+  catch (error) { reportError(error) }
+  finally { setBusy(false) }
+}
+
+async function applyCheckedUpdate(): Promise<void> {
+  const checked = check.value
+  if (busy.value || props.disabled || !checked?.available || !checked.release || !checked.compatibility?.compatible) return
+  const wasEnabled = props.plugin.state === 'enabled' || props.plugin.bindings.some(binding => binding.enabled)
+  let acceptUntested = false
+  if (wasEnabled && !checked.compatibility.tested) {
+    acceptUntested = window.confirm(t('admin.plugins.confirmUntested'))
+    if (!acceptUntested) return
+  }
+  if (!window.confirm(t(wasEnabled ? 'admin.plugins.confirmUpdateRunning' : 'admin.plugins.confirmUpdateDisabled', {
+    name: props.plugin.name, version: checked.release.version,
+  }))) return
+  setBusy(true)
+  try {
+    const result = await stepUp.run(() => adminAPI.plugins.applyUpdate(props.plugin.id, {
+      current_version: checked.current_version,
+      target_version: checked.release!.version,
+      sha256: checked.release!.sha256,
+      confirm_maintenance: wasEnabled,
+      resume: wasEnabled,
+      accept_untested: acceptUntested,
+    }))
+    if (result.status === 'installed_not_running') store.showError(result.message)
+    else store.showSuccess(result.message)
+  } catch (error) { reportError(error) }
+  finally {
+    check.value = null
+    setBusy(false)
+    // Refresh even after errors: a cancelled HTTP response is not proof that a
+    // maintenance or database transition did not happen. No automatic replay.
+    emit('changed')
+  }
+}
+</script>
