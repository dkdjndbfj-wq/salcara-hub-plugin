@@ -0,0 +1,36 @@
+package admin
+
+import (
+	"net/http/httptest"
+	"testing"
+)
+
+func TestHubRequestUsesHostSocketPeerNotClientIPHeaders(t *testing.T) {
+	for _, tc := range []struct{ remote, want string }{
+		{"192.0.2.10:4567", "192.0.2.10"},
+		{"[2001:db8::10]:4567", "2001:db8::10"},
+		{"invalid", ""},
+	} {
+		request := httptest.NewRequest("GET", "http://example.test/salcara-hub/v1/ping", nil)
+		request.RemoteAddr = tc.remote
+		for _, header := range []string{"X-Salcara-Peer-IP", "X-Forwarded-For", "X-Real-IP", "Forwarded"} {
+			request.Header.Set(header, "198.51.100.99")
+		}
+		request.Header.Set("X-Salcara-Device-Id", "pc-one")
+		forwarded := hubRequestWithSocketPeer(request)
+		if got := forwarded.Header.Get("X-Salcara-Peer-IP"); got != tc.want {
+			t.Fatalf("peer %s: got %q want %q", tc.remote, got, tc.want)
+		}
+		for _, header := range []string{"X-Forwarded-For", "X-Real-IP", "Forwarded"} {
+			if forwarded.Header.Get(header) != "" {
+				t.Fatalf("untrusted header forwarded: %s", header)
+			}
+		}
+		if request.Header.Get("X-Salcara-Peer-IP") != "198.51.100.99" {
+			t.Fatal("original request mutated")
+		}
+		if forwarded.Header.Get("X-Salcara-Device-Id") != "pc-one" {
+			t.Fatal("device authentication headers lost")
+		}
+	}
+}
