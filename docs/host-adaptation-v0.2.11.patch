+package admin
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPluginUpdateHandlerRejectsClientTrustRootsURLsAndMalformedBodies(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	router := gin.New()
+	// A nil manager proves rejected input never reaches repository/network work.
+	router.POST("/plugins/:id/update", NewPluginHandler(nil).ApplyUpdate)
+	for _, body := range []string{
+		`{"package_url":"https://attacker.example/plugin"}`,
+		`{"public_key":"client-key"}`,
+		`{"publisher_key_id":"client-publisher"}`,
+		`{"current_version":"0.3.1"}{}`,
+		`{"current_version":true}`,
+		`{"current_version":"` + strings.Repeat("x", 2048) + `"}`,
+	} {
+		request := httptest.NewRequest(http.MethodPost, "/plugins/7/update", strings.NewReader(body))
+		response := httptest.NewRecorder()
+		router.ServeHTTP(response, request)
+		require.Equal(t, http.StatusBadRequest, response.Code)
+	}
+}
diff --git a/backend/internal/service/plugin_update.go b/backend/internal/service/plugin_update.go
new file mode 100644
--- /dev/null
+++ b/backend/internal/service/plugin_update.go
@@ -0,0 +1,343 @@
+package service
+
+import (
+	"archive/zip"
+	"bytes"
+	"context"
+	"crypto/ed25519"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"reflect"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"golang.org/x/mod/semver"
+)
+
+const (
+	pluginUpdateFeedMaxBytes         = 64 * 1024
+	pluginUpdatePackageMaxBytes      = 128 * 1024 * 1024
+	defaultSalcaraHubUpdateURL       = "https://github.com/dkdjndbfj-wq/salcara-hub-plugin/releases/latest/download/update.json"
+	defaultSalcaraHubUpdatePublisher = "salcara-local-20260930"
+)
+
+type PluginUpdateFeed struct {
+	SchemaVersion  int                `json:"schema_version"`
+	PluginID       string             `json:"plugin_id"`
+	Version        string             `json:"version"`
+	PackageURL     string             `json:"package_url"`
+	SHA256         string             `json:"sha256"`
+	SizeBytes      int64              `json:"size_bytes"`
+	PublisherKeyID string             `json:"publisher_key_id"`
+	Requires       PluginRequirements `json:"requires"`
+	ReleaseNotes   string             `json:"release_notes,omitempty"`
+}
+
+type PluginUpdateCheck struct {
+	Configured     bool                 `json:"configured"`
+	Available      bool                 `json:"available"`
+	Status         string               `json:"status"`
+	Message        string               `json:"message"`
+	CurrentVersion string               `json:"current_version"`
+	CheckedAt      time.Time            `json:"checked_at"`
+	Release        *PluginUpdateFeed    `json:"release,omitempty"`
+	Compatibility  *PluginCompatibility `json:"compatibility,omitempty"`
+}
+
+type PluginUpdateRequest struct {
+	CurrentVersion     string `json:"current_version"`
+	TargetVersion      string `json:"target_version"`
+	SHA256             string `json:"sha256"`
+	ConfirmMaintenance bool   `json:"confirm_maintenance"`
+	Resume             bool   `json:"resume"`
+	AcceptUntested     bool   `json:"accept_untested"`
+}
+
+type PluginUpdateResult struct {
+	Plugin  *PluginInstallation `json:"plugin"`
+	Status  string              `json:"status"`
+	Message string              `json:"message"`
+	Running bool                `json:"running"`
+}
+
+// Optional extension keeps ordinary manual installation interfaces unchanged.
+// Update replacement and resume must compare versions across host instances.
+type PluginUpdateRepository interface {
+	InstallUpdate(context.Context, *PluginInstallation, *PluginInstallation, []PluginBinding) (*PluginInstallation, error)
+	BeginEnableUpdate(context.Context, int64, string, string, string, string) error
+	FinishEnableUpdate(context.Context, *PluginInstallation, []PluginBinding, string, string, *time.Time) error
+	StopForUpdate(context.Context, *PluginInstallation, []PluginBinding) error
+}
+
+func (m *PluginManager) pluginUpdateSource(pluginID string) (config.PluginUpdateSource, bool) {
+	if m.cfg == nil {
+		return config.PluginUpdateSource{}, false
+	}
+	if source, ok := m.cfg.Plugins.UpdateSources[pluginID]; ok {
+		// An explicitly empty operator entry disables even the built-in Hub source.
+		return source, strings.TrimSpace(source.URL) != ""
+	}
+	if pluginID == builtInSalcaraHubPluginID {
+		return config.PluginUpdateSource{URL: defaultSalcaraHubUpdateURL, PublisherKeyID: defaultSalcaraHubUpdatePublisher}, true
+	}
+	return config.PluginUpdateSource{}, false
+}
+
+func (m *PluginManager) pluginUpdateDownloadLimit() int64 {
+	if m.cfg == nil || m.cfg.Plugins.MaxUploadBytes <= 0 {
+		return 0
+	}
+	if m.cfg.Plugins.MaxUploadBytes < pluginUpdatePackageMaxBytes {
+		return m.cfg.Plugins.MaxUploadBytes
+	}
+	return pluginUpdatePackageMaxBytes
+}
+
+func (m *PluginManager) CheckUpdate(ctx context.Context, id int64) (*PluginUpdateCheck, error) {
+	client := newPluginUpdateHTTPClient()
+	client.Timeout = 15 * time.Second
+	defer client.CloseIdleConnections()
+	return m.checkPluginUpdate(ctx, id, client)
+}
+
+func (m *PluginManager) checkPluginUpdate(ctx context.Context, id int64, client *http.Client) (*PluginUpdateCheck, error) {
+	installation, err := m.repo.GetByID(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	result := &PluginUpdateCheck{CurrentVersion: installation.Version, CheckedAt: time.Now().UTC()}
+	source, configured := m.pluginUpdateSource(installation.PluginKey)
+	result.Configured = configured
+	if !configured {
+		result.Status, result.Message = "not_configured", "未配置此插件的受信任更新源；请联系服务器管理员配置或手动上传签名包"
+		return result, nil
+	}
+	key, err := base64.StdEncoding.DecodeString(trustedPluginPublisherKey(m.cfg, source.PublisherKeyID, installation.PluginKey))
+	if strings.TrimSpace(source.PublisherKeyID) == "" || err != nil || len(key) != ed25519.PublicKeySize {
+		result.Status, result.Message = "publisher_untrusted", "更新源发布者尚未受信任；管理员需核对并配置其公钥，不能由更新清单自动授权"
+		return result, nil
+	}
+	data, status, err := fetchPluginUpdateBytes(ctx, client, source.URL, pluginUpdateFeedMaxBytes)
+	if err != nil {
+		return nil, err
+	}
+	if status == http.StatusNotFound {
+		result.Status, result.Message = "unpublished", "更新源尚未提供公开更新清单"
+		return result, nil
+	}
+	if status != http.StatusOK {
+		return nil, fmt.Errorf("检查插件更新失败（HTTP %d）", status)
+	}
+	feed, err := decodePluginUpdateFeed(data, installation.PluginKey, source.PublisherKeyID, m.pluginUpdateDownloadLimit())
+	if err != nil {
+		return nil, err
+	}
+	result.Release = feed
+	installedVersion, candidateVersion := normalizeSemver(installation.Version), normalizeSemver(feed.Version)
+	if installedVersion == "" {
+		return nil, errors.New("当前插件版本无效，不能安全判断自动更新顺序")
+	}
+	if semver.Compare(candidateVersion, installedVersion) <= 0 {
+		result.Status, result.Message = "current", "没有更高版本；更新不会降级或重复安装当前版本"
+		return result, nil
+	}
+	compatibility := EvaluatePluginCompatibility(PluginManifest{Requires: feed.Requires}, m.hostInfo)
+	result.Compatibility = &compatibility
+	if !compatibility.Compatible {
+		result.Status, result.Message = "incompatible", "新插件要求与当前宿主不兼容；此按钮不会升级 Sub2API 服务器"
+		return result, nil
+	}
+	result.Available, result.Status = true, "available"
+	result.Message = "发现新版本；实际插件包仍需下载后完成签名、文件和兼容性验证"
+	return result, nil
+}
+
+func decodePluginUpdateFeed(data []byte, pluginID, publisherKeyID string, maxBytes int64) (*PluginUpdateFeed, error) {
+	var feed PluginUpdateFeed
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(&feed) != nil || decoder.Decode(&struct{}{}) != io.EOF {
+		return nil, errors.New("插件更新清单必须是单个、无未知字段的 JSON 对象")
+	}
+	if feed.SchemaVersion != 1 || feed.PluginID != pluginID || feed.PublisherKeyID != publisherKeyID || normalizeSemver(feed.Version) == "" || len(feed.Version) > 64 || !regexp.MustCompile(`^[a-f0-9]{64}$`).MatchString(feed.SHA256) || feed.SizeBytes <= 0 || feed.SizeBytes > maxBytes || len(feed.ReleaseNotes) > 4096 {
+		return nil, errors.New("插件更新清单的 ID、版本、发布者、哈希或大小不符合安全要求")
+	}
+	if _, err := validatePluginUpdateURL(feed.PackageURL); err != nil {
+		return nil, err
+	}
+	if feed.Requires.Sub2API == "" || len(feed.Requires.Sub2API) > 256 || len(feed.Requires.TestedSub2APIVersions) > 64 {
+		return nil, errors.New("插件更新清单缺少有效宿主要求")
+	}
+	return &feed, nil
+}
+
+func (m *PluginManager) ApplyUpdate(ctx context.Context, id int64, request PluginUpdateRequest, installedBy *int64) (*PluginUpdateResult, error) {
+	if !m.updateMu.TryLock() {
+		return nil, errors.New("已有插件更新正在下载或安装，请等待完成后重新检查；没有排队或重复下载")
+	}
+	defer m.updateMu.Unlock()
+	ctx, cancel := context.WithTimeout(ctx, 120*time.Second)
+	defer cancel()
+	client := newPluginUpdateHTTPClient()
+	defer client.CloseIdleConnections()
+	return m.applyPluginUpdate(ctx, id, request, installedBy, client)
+}
+
+func (m *PluginManager) applyPluginUpdate(ctx context.Context, id int64, request PluginUpdateRequest, installedBy *int64, client *http.Client) (*PluginUpdateResult, error) {
+	checkCtx, cancel := context.WithTimeout(ctx, 15*time.Second)
+	check, err := m.checkPluginUpdate(checkCtx, id, client)
+	cancel()
+	if err != nil {
+		return nil, err
+	}
+	if !check.Available || check.Release == nil {
+		return nil, errors.New(check.Message)
+	}
+	feed := check.Release
+	if request.CurrentVersion != check.CurrentVersion || request.TargetVersion != feed.Version || request.SHA256 != feed.SHA256 {
+		return nil, errors.New("插件或更新清单已变化，请重新检查并确认；没有停用原版")
+	}
+	previous, err := m.repo.GetByID(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	if previous.Version != request.CurrentVersion {
+		return nil, ErrPluginStateChanged
+	}
+	if request.Resume && !check.Compatibility.Tested && !request.AcceptUntested {
+		return nil, errors.New("新版本未声明已测试当前宿主，需要明确确认后才能恢复运行")
+	}
+	data, status, err := fetchPluginUpdateBytes(ctx, client, feed.PackageURL, feed.SizeBytes)
+	if err != nil {
+		return nil, err
+	}
+	if status != http.StatusOK {
+		return nil, fmt.Errorf("下载插件包失败（HTTP %d）；没有停用原版", status)
+	}
+	hash := sha256.Sum256(data)
+	if int64(len(data)) != feed.SizeBytes || hex.EncodeToString(hash[:]) != feed.SHA256 {
+		return nil, errors.New("插件包大小或 SHA-256 不匹配；没有停用原版")
+	}
+	// A separate nonce installation is verified and extracted without replacing
+	// any database entry or stopping the running plugin.
+	prepared, err := m.installer.Install(ctx, bytes.NewReader(data), installedBy)
+	if err != nil {
+		return nil, err
+	}
+	keepPrepared := false
+	defer func() {
+		if !keepPrepared {
+			_ = m.cleanupInstallationFiles(prepared)
+		}
+	}()
+	if err := validatePreparedPluginUpdate(prepared, previous, feed, data); err != nil {
+		return nil, err
+	}
+	result, retain, err := m.commitPluginUpdate(ctx, previous, prepared, request)
+	keepPrepared = retain
+	return result, err
+}
+
+func validatePreparedPluginUpdate(prepared, previous *PluginInstallation, feed *PluginUpdateFeed, data []byte) error {
+	if prepared.SignatureStatus != PluginSignatureTrusted || prepared.PluginKey != previous.PluginKey || prepared.PluginKey != feed.PluginID || prepared.Version != feed.Version || !prepared.Compatibility.Compatible || semver.Compare(normalizeSemver(prepared.Version), normalizeSemver(previous.Version)) <= 0 {
+		return errors.New("验签后的插件 ID、版本或兼容性不符合更新要求；原版尚未停用")
+	}
+	if !reflect.DeepEqual(prepared.Manifest.Requires, feed.Requires) || !reflect.DeepEqual(prepared.Manifest.SortedCapabilities(), previous.Manifest.SortedCapabilities()) {
+		return errors.New("更新清单与签名包要求不一致，或插件能力发生变化；请人工审核，原版尚未停用")
+	}
+	archive, err := zip.NewReader(bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		return errors.New("无法读取已验证插件签名")
+	}
+	for _, entry := range archive.File {
+		if entry.Name != pluginSignatureFilename {
+			continue
+		}
+		raw, err := readPluginZipFile(entry, 64*1024)
+		if err != nil {
+			return errors.New("无法读取已验证插件签名")
+		}
+		var signature PluginSignature
+		if json.Unmarshal(raw, &signature) == nil && signature.Algorithm == "ed25519" && signature.KeyID == feed.PublisherKeyID {
+			return nil
+		}
+		return errors.New("签名发布者不是管理员为此更新源固定的发布者；原版尚未停用")
+	}
+	return errors.New("自动更新必须携带受信任的固定发布者签名；原版尚未停用")
+}
+
+func (m *PluginManager) commitPluginUpdate(ctx context.Context, previous, prepared *PluginInstallation, request PluginUpdateRequest) (*PluginUpdateResult, bool, error) {
+	m.operationMu.Lock()
+	defer m.operationMu.Unlock()
+	current, err := m.repo.GetByID(ctx, previous.ID)
+	if err != nil {
+		return nil, false, err
+	}
+	if current.PluginKey != previous.PluginKey || current.Version != previous.Version || current.BinarySHA256 != previous.BinarySHA256 || current.ConfigEncrypted != previous.ConfigEncrypted || current.State == PluginStateStarting {
+		return nil, false, ErrPluginStateChanged
+	}
+	repository, ok := m.repo.(PluginUpdateRepository)
+	if !ok {
+		return nil, false, errors.New("插件仓库不支持安全原子更新")
+	}
+	wasEnabled := current.State == PluginStateEnabled || hasEnabledOpenAIBinding(current.Bindings) || hasEnabledHubBinding(current.Bindings)
+	if wasEnabled && !request.ConfirmMaintenance {
+		return nil, false, errors.New("更新运行中的插件需要明确确认维护断连")
+	}
+	rollout := bindingRollout(current.Bindings)
+	if rollout < 1 || rollout > 100 {
+		rollout = 100
+	}
+	bindings := append([]PluginBinding(nil), current.Bindings...)
+	for index := range bindings {
+		bindings[index].Enabled = false
+	}
+	if wasEnabled {
+		if err := repository.StopForUpdate(ctx, current, bindings); err != nil {
+			return nil, false, err
+		}
+		m.mu.Lock()
+		runtime := m.removeRuntimeLocked(current.ID)
+		m.mu.Unlock()
+		if runtime != nil {
+			runtime.drain(10 * time.Second)
+		}
+	}
+	installed, err := repository.InstallUpdate(ctx, current, prepared, bindings)
+	if err != nil {
+		return nil, true, errors.New("插件包已验证，但数据库换包失败或状态不确定；原版包文件保留，但插件可能已停用。请刷新状态确认，不能视为自动回滚")
+	}
+	prepared.ID, prepared.ConfigEncrypted, prepared.Bindings = installed.ID, installed.ConfigEncrypted, append([]PluginBinding(nil), installed.Bindings...)
+	m.mu.Lock()
+	oldLocal := m.localInstallations[installed.ID]
+	m.localInstallations[installed.ID] = prepared
+	m.mu.Unlock()
+	// Only successful replacement retires old local binaries. Plugin KV records
+	// and encrypted configuration are not deleted by this path.
+	_ = m.cleanupInstallationFiles(current)
+	if oldLocal != nil && oldLocal.InstallPath != current.InstallPath {
+		_ = m.cleanupInstallationFiles(oldLocal)
+	}
+	result := &PluginUpdateResult{Plugin: installed, Status: "installed_disabled", Message: "签名更新已安装，配置和宿主存储数据已保留；插件目前停用，可手动启用"}
+	if wasEnabled && request.Resume {
+		running, enableErr := m.enableLocked(ctx, installed.ID, request.AcceptUntested, rollout, prepared.Version)
+		if enableErr != nil {
+			result.Status, result.Message = "installed_not_running", "新版本已安装，但恢复运行失败；请查看插件状态并处理，不代表已回滚旧版本"
+			if current, getErr := m.Get(ctx, installed.ID); getErr == nil {
+				result.Plugin = current
+			}
+			return result, true, nil
+		}
+		result.Plugin, result.Running, result.Status = running, true, "updated_running"
+		result.Message = "签名更新已安装并恢复运行；配置和宿主存储数据已保留"
+	}
+	return result, true, nil
+}
diff --git a/backend/internal/service/plugin_update_http.go b/backend/internal/service/plugin_update_http.go
new file mode 100644
--- /dev/null
+++ b/backend/internal/service/plugin_update_http.go
@@ -0,0 +1,149 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/netip"
+	"net/url"
+	"strings"
+	"time"
+)
+
+// This client is intentionally independent of gateway proxies, cookies, API
+// keys, environment proxies, and the optional gateway SSRF feature switch.
+func newPluginUpdateHTTPClient() *http.Client {
+	transport := &http.Transport{
+		Proxy: nil, DisableKeepAlives: true,
+		TLSHandshakeTimeout: 10 * time.Second, ResponseHeaderTimeout: 15 * time.Second,
+		DialContext: dialPluginUpdatePublic,
+	}
+	return &http.Client{Transport: transport, Timeout: 90 * time.Second, CheckRedirect: pluginUpdateRedirect}
+}
+
+func validatePluginUpdateURL(raw string) (*url.URL, error) {
+	if len(raw) == 0 || len(raw) > 8192 || strings.TrimSpace(raw) != raw {
+		return nil, errors.New("插件更新地址无效")
+	}
+	u, err := url.Parse(raw)
+	if err != nil || u.Scheme != "https" || u.Hostname() == "" || u.User != nil || u.Fragment != "" || u.Opaque != "" || (u.Port() != "" && u.Port() != "443") {
+		return nil, errors.New("插件更新地址必须是无凭据的 HTTPS 公网地址（443 端口）")
+	}
+	host := strings.ToLower(u.Hostname())
+	if strings.Contains(host, "%") || host == "localhost" || strings.HasSuffix(host, ".localhost") || !strings.Contains(host, ".") && !strings.Contains(host, ":") {
+		return nil, errors.New("插件更新不允许本地或内部地址")
+	}
+	if ip, err := netip.ParseAddr(host); err == nil && !pluginUpdatePublicIP(ip) {
+		return nil, errors.New("插件更新不允许非公网 IP 地址")
+	}
+	return u, nil
+}
+
+func pluginUpdateRedirect(request *http.Request, via []*http.Request) error {
+	if len(via) >= 5 {
+		return errors.New("插件更新重定向次数超过限制")
+	}
+	if _, err := validatePluginUpdateURL(request.URL.String()); err != nil {
+		return err
+	}
+	// Never forward credentials or caller headers, even across legitimate release
+	// CDN redirects. Every new connection repeats DNS checks and pins its IP.
+	request.Header = http.Header{"Accept": {"application/octet-stream,application/json"}, "User-Agent": {"Sub2API-Plugin-Updater/1"}}
+	return nil
+}
+
+var pluginUpdateBlockedNetworks = []netip.Prefix{
+	netip.MustParsePrefix("0.0.0.0/8"), netip.MustParsePrefix("10.0.0.0/8"),
+	netip.MustParsePrefix("100.64.0.0/10"), netip.MustParsePrefix("127.0.0.0/8"),
+	netip.MustParsePrefix("169.254.0.0/16"), netip.MustParsePrefix("172.16.0.0/12"),
+	netip.MustParsePrefix("192.0.0.0/24"), netip.MustParsePrefix("192.0.2.0/24"),
+	netip.MustParsePrefix("192.88.99.0/24"), netip.MustParsePrefix("192.168.0.0/16"),
+	netip.MustParsePrefix("198.18.0.0/15"), netip.MustParsePrefix("198.51.100.0/24"),
+	netip.MustParsePrefix("203.0.113.0/24"), netip.MustParsePrefix("224.0.0.0/4"),
+	netip.MustParsePrefix("240.0.0.0/4"), netip.MustParsePrefix("2001::/23"),
+	netip.MustParsePrefix("2001:db8::/32"), netip.MustParsePrefix("2002::/16"),
+	netip.MustParsePrefix("3fff::/20"),
+}
+
+func pluginUpdatePublicIP(ip netip.Addr) bool {
+	if !ip.IsValid() || ip.Zone() != "" {
+		return false
+	}
+	ip = ip.Unmap()
+	if !ip.IsGlobalUnicast() || ip.IsPrivate() {
+		return false
+	}
+	if ip.Is6() && !netip.MustParsePrefix("2000::/3").Contains(ip) {
+		return false
+	}
+	for _, network := range pluginUpdateBlockedNetworks {
+		if network.Contains(ip) {
+			return false
+		}
+	}
+	return true
+}
+
+func dialPluginUpdatePublic(ctx context.Context, network, address string) (net.Conn, error) {
+	dialer := net.Dialer{Timeout: 10 * time.Second}
+	return dialPluginUpdatePublicWith(ctx, network, address, net.DefaultResolver.LookupNetIP, dialer.DialContext)
+}
+
+func dialPluginUpdatePublicWith(ctx context.Context, network, address string, lookup func(context.Context, string, string) ([]netip.Addr, error), dial func(context.Context, string, string) (net.Conn, error)) (net.Conn, error) {
+	host, port, err := net.SplitHostPort(address)
+	if err != nil || port != "443" {
+		return nil, errors.New("插件更新目标端口无效")
+	}
+	lookupCtx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	addresses, err := lookup(lookupCtx, "ip", host)
+	if err != nil || len(addresses) == 0 || len(addresses) > 64 {
+		return nil, errors.New("插件更新域名解析失败")
+	}
+	for _, ip := range addresses {
+		if !pluginUpdatePublicIP(ip) {
+			return nil, errors.New("插件更新域名解析到了非公网地址")
+		}
+	}
+	for _, ip := range addresses {
+		conn, err := dial(ctx, network, net.JoinHostPort(ip.String(), port))
+		if err == nil {
+			return conn, nil
+		}
+	}
+	return nil, errors.New("无法连接插件更新公网服务器")
+}
+
+func fetchPluginUpdateBytes(ctx context.Context, client *http.Client, rawURL string, limit int64) ([]byte, int, error) {
+	u, err := validatePluginUpdateURL(rawURL)
+	if err != nil {
+		return nil, 0, err
+	}
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, u.String(), nil)
+	if err != nil {
+		return nil, 0, errors.New("无法创建插件更新请求")
+	}
+	request.Header.Set("Accept", "application/octet-stream,application/json")
+	request.Header.Set("User-Agent", "Sub2API-Plugin-Updater/1")
+	response, err := client.Do(request)
+	if err != nil {
+		return nil, 0, errors.New("插件更新网络请求失败或超时；请稍后重试")
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		return nil, response.StatusCode, nil
+	}
+	if limit <= 0 || response.ContentLength > limit {
+		return nil, response.StatusCode, errors.New("插件更新下载超过大小限制")
+	}
+	data, err := io.ReadAll(io.LimitReader(response.Body, limit+1))
+	if err != nil {
+		return nil, response.StatusCode, errors.New("插件更新下载中断；原版尚未停用")
+	}
+	if int64(len(data)) > limit {
+		return nil, response.StatusCode, errors.New("插件更新下载超过大小限制")
+	}
+	return data, response.StatusCode, nil
+}
