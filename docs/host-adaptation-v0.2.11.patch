new file mode 100644
--- /dev/null
+++ b/backend/internal/config/plugin_update_config_test.go
@@ -0,0 +1,36 @@
+package config
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/spf13/viper"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPluginUpdateConfigPreservesDottedPluginIDsAndExplicitDisable(t *testing.T) {
+	for _, updateURL := range []string{"https://updates.example/update.json", ""} {
+		v := viper.New()
+		v.SetConfigType("yaml")
+		require.NoError(t, v.ReadConfig(strings.NewReader(`plugins:
+  allow_unsigned: false
+  trusted_publishers:
+    fixed-publisher: "fixture-public-key"
+  update_sources:
+    top.salcara.hub:
+      url: "`+updateURL+`"
+      publisher_key_id: "fixed-publisher"
+`)))
+		var cfg Config
+		require.NoError(t, v.Unmarshal(&cfg))
+		updateSources, err := decodePluginUpdateSources(v)
+		require.NoError(t, err)
+		cfg.Plugins.UpdateSources = updateSources
+		source, ok := cfg.Plugins.UpdateSources["top.salcara.hub"]
+		require.True(t, ok, "the deployment config must preserve a plugin ID as one map key")
+		require.Equal(t, updateURL, source.URL)
+		require.Equal(t, "fixed-publisher", source.PublisherKeyID)
+		require.False(t, cfg.Plugins.AllowUnsigned)
+		require.Equal(t, "fixture-public-key", cfg.Plugins.TrustedPublishers["fixed-publisher"])
+	}
+}
diff --git a/backend/internal/handler/admin/plugin_hub_handler.go b/backend/internal/handler/admin/plugin_hub_handler.go
new file mode 100644
--- /dev/null
+++ b/backend/internal/handler/admin/plugin_hub_handler.go
@@ -0,0 +1,136 @@
+package admin
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/response"
+	"github.com/Wei-Shaw/sub2api/internal/server/middleware"
+	"io"
+	"net"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/gin-gonic/gin"
+)
+
+var hubHopHeaders = map[string]bool{
+	"connection": true, "keep-alive": true, "proxy-authenticate": true,
+	"proxy-authorization": true, "te": true, "trailer": true,
+	"transfer-encoding": true, "upgrade": true,
+}
+
+func (h *PluginHandler) HubSnapshot(c *gin.Context) {
+	id, ok := pluginIDParam(c)
+	if !ok {
+		return
+	}
+	var query struct {
+		Query  string `form:"query" json:"query"`
+		Filter string `form:"filter" json:"filter"`
+		Offset int    `form:"offset" json:"offset"`
+		Limit  int    `form:"limit" json:"limit"`
+	}
+	if c.ShouldBindQuery(&query) != nil {
+		response.BadRequest(c, "设备列表筛选无效")
+		return
+	}
+	input, _ := json.Marshal(query)
+	result, err := h.manager.HubAdmin(c.Request.Context(), id, "snapshot", input)
+	if err != nil {
+		response.BadRequest(c, err.Error())
+		return
+	}
+	response.Success(c, json.RawMessage(result))
+}
+
+func (h *PluginHandler) HubAction(c *gin.Context) {
+	id, ok := pluginIDParam(c)
+	if !ok {
+		return
+	}
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 4096)
+	var in struct {
+		Action string `json:"action"`
+		Ref    string `json:"ref"`
+		Reason string `json:"reason"`
+	}
+	if c.ShouldBindJSON(&in) != nil {
+		response.BadRequest(c, "设备操作格式无效")
+		return
+	}
+	actor := "host-admin"
+	if subject, ok := middleware.GetAuthSubjectFromContext(c); ok && subject.UserID > 0 {
+		actor = fmt.Sprintf("host-admin:%d", subject.UserID)
+	}
+	input, _ := json.Marshal(map[string]string{"action": in.Action, "ref": in.Ref, "reason": in.Reason, "actor": actor})
+	ctx, cancel := context.WithTimeout(c.Request.Context(), 12*time.Second)
+	defer cancel()
+	result, err := h.manager.HubAdmin(ctx, id, "action", input)
+	if err != nil {
+		response.BadRequest(c, err.Error())
+		return
+	}
+	response.Success(c, json.RawMessage(result))
+}
+
+// ServeSalcaraHub is deliberately public: the Hub authenticates enrolled
+// computers and paired phones independently. It is not an admin endpoint and
+// must not depend on a browser/JWT session or model API-key eligibility.
+func (h *PluginHandler) ServeSalcaraHub(c *gin.Context) {
+	if h == nil || h.manager == nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "Salcara Hub 插件未配置"})
+		return
+	}
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 4<<20)
+	request := hubRequestWithSocketPeer(c.Request)
+	response, err := h.manager.RoundTripSalcaraHub(request.Context(), request)
+	if err != nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "Salcara Hub 暂不可用"})
+		return
+	}
+	defer func() { _ = response.Body.Close() }()
+	for name, values := range response.Header {
+		if hubHopHeaders[strings.ToLower(name)] {
+			continue
+		}
+		for _, value := range values {
+			c.Writer.Header().Add(name, value)
+		}
+	}
+	c.Status(response.StatusCode)
+	buffer := make([]byte, 32*1024)
+	for {
+		read, readErr := response.Body.Read(buffer)
+		if read > 0 {
+			if _, writeErr := c.Writer.Write(buffer[:read]); writeErr != nil {
+				return
+			}
+			// Forward every SSE frame immediately, including heartbeat comments.
+			c.Writer.Flush()
+		}
+		if readErr == io.EOF {
+			return
+		}
+		if readErr != nil {
+			return
+		}
+	}
+}
+
+// The plugin transport does not serialize RemoteAddr. Pass only a host-created
+// socket-peer hint, never an Internet client's forwarded-IP assertion. When
+// nginx fronts this host, its socket address intentionally shares one bucket.
+func hubRequestWithSocketPeer(request *http.Request) *http.Request {
+	forwarded := request.Clone(request.Context())
+	forwarded.Header.Del("X-Salcara-Peer-IP")
+	forwarded.Header.Del("X-Forwarded-For")
+	forwarded.Header.Del("X-Real-IP")
+	forwarded.Header.Del("Forwarded")
+	peer, _, err := net.SplitHostPort(request.RemoteAddr)
+	if err == nil && net.ParseIP(peer) != nil {
+		forwarded.Header.Set("X-Salcara-Peer-IP", peer)
+	}
+	return forwarded
+}
diff --git a/backend/internal/handler/admin/plugin_hub_handler_test.go b/backend/internal/handler/admin/plugin_hub_handler_test.go
