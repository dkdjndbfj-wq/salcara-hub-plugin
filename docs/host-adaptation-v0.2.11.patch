@@ -0,0 +1,61 @@
+package service
+
+import (
+	"archive/zip"
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// This opt-in offline check uses the real installer, but only a disposable data
+// directory. It never updates the running server's publisher trust or plugins.
+func TestLocalSignedHubArtifact(t *testing.T) {
+	path, publisherPath := os.Getenv("SALCARA_TEST_SIGNED_PACKAGE"), os.Getenv("SALCARA_TEST_PUBLIC_IDENTITY")
+	if path == "" || publisherPath == "" {
+		t.Skip("local signed artifact paths not provided")
+	}
+	publicRaw, err := os.ReadFile(publisherPath)
+	require.NoError(t, err)
+	var publisher struct {
+		KeyID     string `json:"key_id"`
+		PublicKey string `json:"public_key"`
+	}
+	require.NoError(t, json.Unmarshal(publicRaw, &publisher))
+	require.NotEmpty(t, publisher.KeyID)
+	require.NotEmpty(t, publisher.PublicKey)
+	archive, err := os.ReadFile(path)
+	require.NoError(t, err)
+	cfg := testPluginConfig(t.TempDir(), false)
+	cfg.Plugins.TrustedPublishers[publisher.KeyID] = publisher.PublicKey
+	installer := NewPluginPackageInstaller(cfg, PluginHostInfo{Version: "0.2.11+salcara.hub.1", BuildType: "experimental"})
+	installed, err := installer.Install(context.Background(), bytes.NewReader(archive), nil)
+	require.NoError(t, err)
+	require.Equal(t, "top.salcara.hub", installed.Manifest.ID)
+	require.Equal(t, PluginSignatureTrusted, installed.SignatureStatus)
+	require.True(t, installed.Compatibility.Compatible)
+	untrusted := NewPluginPackageInstaller(testPluginConfig(t.TempDir(), false), PluginHostInfo{Version: "0.2.11+salcara.hub.1"})
+	_, err = untrusted.Install(context.Background(), bytes.NewReader(archive), nil)
+	require.ErrorContains(t, err, "不受信任")
+	reader, err := zip.NewReader(bytes.NewReader(archive), int64(len(archive)))
+	require.NoError(t, err)
+	var tampered bytes.Buffer
+	writer := zip.NewWriter(&tampered)
+	for _, file := range reader.File {
+		content, err := readPluginZipFile(file, 64*1024*1024)
+		require.NoError(t, err)
+		if file.Name == "manifest.json" {
+			content = bytes.Replace(content, []byte(`"author": "Salcara"`), []byte(`"author": "Tampered"`), 1)
+		}
+		entry, err := writer.Create(file.Name)
+		require.NoError(t, err)
+		_, err = entry.Write(content)
+		require.NoError(t, err)
+	}
+	require.NoError(t, writer.Close())
+	_, err = installer.Install(context.Background(), bytes.NewReader(tampered.Bytes()), nil)
+	require.ErrorContains(t, err, "签名校验失败")
+}
