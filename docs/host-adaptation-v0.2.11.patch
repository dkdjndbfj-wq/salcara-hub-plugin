+package admin
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/response"
+	"github.com/Wei-Shaw/sub2api/internal/server/middleware"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+)
+
+// CheckUpdate is explicitly requested by an authenticated admin; there is no
+// scheduled fetch. URLs and trust roots come only from deployment configuration.
+func (h *PluginHandler) CheckUpdate(c *gin.Context) {
+	id, ok := pluginIDParam(c)
+	if !ok {
+		return
+	}
+	result, err := h.manager.CheckUpdate(c.Request.Context(), id)
+	if err != nil {
+		response.BadRequest(c, err.Error())
+		return
+	}
+	response.Success(c, result)
+}
+
+// ApplyUpdate is registered behind the same host step-up gate as manual upload.
+func (h *PluginHandler) ApplyUpdate(c *gin.Context) {
+	id, ok := pluginIDParam(c)
+	if !ok {
+		return
+	}
+	decoder := json.NewDecoder(http.MaxBytesReader(c.Writer, c.Request.Body, 2048))
+	decoder.DisallowUnknownFields()
+	var request service.PluginUpdateRequest
+	if decoder.Decode(&request) != nil || decoder.Decode(&struct{}{}) != io.EOF {
+		response.BadRequest(c, "更新请求无效；不能从前端指定下载地址或发布者公钥")
+		return
+	}
+	var installedBy *int64
+	if subject, ok := middleware.GetAuthSubjectFromContext(c); ok && subject.UserID > 0 {
+		userID := subject.UserID
+		installedBy = &userID
+	}
+	result, err := h.manager.ApplyUpdate(c.Request.Context(), id, request, installedBy)
+	if err != nil {
+		response.BadRequest(c, err.Error())
+		return
+	}
+	response.Success(c, result)
+}
diff --git a/backend/internal/repository/plugin_update_repo.go b/backend/internal/repository/plugin_update_repo.go
new file mode 100644
--- /dev/null
+++ b/backend/internal/repository/plugin_update_repo.go
@@ -0,0 +1,126 @@
+package repository
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+)
+
+func (r *pluginRepository) InstallUpdate(ctx context.Context, previous, candidate *service.PluginInstallation, bindings []service.PluginBinding) (*service.PluginInstallation, error) {
+	manifest, err := json.Marshal(candidate.Manifest)
+	if err != nil {
+		return nil, err
+	}
+	tx, err := r.db.BeginTx(ctx, nil)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback()
+	var id int64
+	err = tx.QueryRowContext(ctx, `UPDATE sub2api_plugin_installations p SET
+		name=$1,version=$2,description=$3,author=$4,manifest=$5::jsonb,artifact_data=$6,
+		artifact_path=$7,install_path=$8,binary_path=$9,binary_sha256=$10,
+		signature_status=$11,state='disabled',last_error='',installed_by=$12,
+		installed_at=NOW(),enabled_at=NULL,updated_at=NOW()
+		WHERE p.id=$13 AND p.plugin_key=$14 AND p.version=$15 AND p.binary_sha256=$16
+		AND p.config_encrypted=$17 AND p.state IN ('disabled','error','incompatible')
+		AND NOT EXISTS (SELECT 1 FROM sub2api_plugin_bindings b WHERE b.plugin_id=p.id AND b.enabled=TRUE)
+		RETURNING p.id`, candidate.Name, candidate.Version, candidate.Description, candidate.Author, manifest, candidate.ArtifactData,
+		candidate.ArtifactPath, candidate.InstallPath, candidate.BinaryPath, candidate.BinarySHA256, candidate.SignatureStatus, candidate.InstalledBy,
+		previous.ID, previous.PluginKey, previous.Version, previous.BinarySHA256, previous.ConfigEncrypted).Scan(&id)
+	if err == sql.ErrNoRows {
+		return nil, service.ErrPluginStateChanged
+	}
+	if err != nil {
+		return nil, err
+	}
+	if err := replacePluginBindings(ctx, tx, id, bindings); err != nil {
+		return nil, err
+	}
+	if err := tx.Commit(); err != nil {
+		return nil, err
+	}
+	return r.GetByID(ctx, id)
+}
+
+func (r *pluginRepository) BeginEnableUpdate(ctx context.Context, id int64, binarySHA256, expectedState, expectedVersion, expectedConfig string) error {
+	result, err := r.db.ExecContext(ctx, `UPDATE sub2api_plugin_installations
+		SET state='starting',last_error='',updated_at=NOW()
+		WHERE id=$1 AND binary_sha256=$2 AND state=$3 AND version=$4 AND config_encrypted=$5 AND state<>'starting'`,
+		id, binarySHA256, expectedState, expectedVersion, expectedConfig)
+	if err != nil {
+		return err
+	}
+	rows, err := result.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if rows != 1 {
+		return service.ErrPluginStateChanged
+	}
+	return nil
+}
+
+// A different host can disable/reinstall a package while this host prepares its
+// process. Comparing only a binary hash is not sufficient: different signed
+// manifests can use the same runtime binary. Final state and binding publication
+// must still belong to this exact version and encrypted configuration.
+func (r *pluginRepository) FinishEnableUpdate(ctx context.Context, expected *service.PluginInstallation, bindings []service.PluginBinding, state, lastError string, enabledAt *time.Time) error {
+	tx, err := r.db.BeginTx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	result, err := tx.ExecContext(ctx, `UPDATE sub2api_plugin_installations
+		SET state=$2,last_error=$3,enabled_at=$4,updated_at=NOW()
+		WHERE id=$1 AND state='starting' AND version=$5 AND binary_sha256=$6 AND config_encrypted=$7`,
+		expected.ID, state, lastError, enabledAt, expected.Version, expected.BinarySHA256, expected.ConfigEncrypted)
+	if err != nil {
+		return err
+	}
+	rows, err := result.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if rows != 1 {
+		return service.ErrPluginStateChanged
+	}
+	if bindings != nil {
+		if err := replacePluginBindings(ctx, tx, expected.ID, bindings); err != nil {
+			return err
+		}
+	}
+	return tx.Commit()
+}
+
+var _ service.PluginUpdateRepository = (*pluginRepository)(nil)
+
+func (r *pluginRepository) StopForUpdate(ctx context.Context, previous *service.PluginInstallation, bindings []service.PluginBinding) error {
+	tx, err := r.db.BeginTx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	result, err := tx.ExecContext(ctx, `UPDATE sub2api_plugin_installations
+		SET state='disabled',last_error='',enabled_at=NULL,updated_at=NOW()
+		WHERE id=$1 AND plugin_key=$2 AND version=$3 AND binary_sha256=$4
+		AND config_encrypted=$5 AND state=$6`, previous.ID, previous.PluginKey, previous.Version,
+		previous.BinarySHA256, previous.ConfigEncrypted, previous.State)
+	if err != nil {
+		return err
+	}
+	rows, err := result.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if rows != 1 {
+		return service.ErrPluginStateChanged
+	}
+	if err := replacePluginBindings(ctx, tx, previous.ID, bindings); err != nil {
+		return err
+	}
+	return tx.Commit()
+}
diff --git a/backend/internal/repository/plugin_update_repo_test.go b/backend/internal/repository/plugin_update_repo_test.go
