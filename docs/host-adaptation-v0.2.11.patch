+type pluginUpdateTransport func(*http.Request) (*http.Response, error)
+
+func (f pluginUpdateTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+type pluginUpdateRepo struct {
+	PluginRepository
+	current      *PluginInstallation
+	installErr   error
+	installCalls int
+	disableCalls int
+	beforeUpdate func()
+	beforeStop   func()
+}
+
+func (r *pluginUpdateRepo) StopForUpdate(ctx context.Context, previous *PluginInstallation, bindings []PluginBinding) error {
+	if r.beforeStop != nil {
+		r.beforeStop()
+	}
+	if r.current.Version != previous.Version || r.current.BinarySHA256 != previous.BinarySHA256 || r.current.ConfigEncrypted != previous.ConfigEncrypted || r.current.State != previous.State {
+		return ErrPluginStateChanged
+	}
+	return r.UpdateBindingsAndState(ctx, previous.ID, bindings, PluginStateDisabled, "", nil, previous.State, previous.BinarySHA256)
+}
+
+func (r *pluginUpdateRepo) InstallUpdate(ctx context.Context, previous, candidate *PluginInstallation, bindings []PluginBinding) (*PluginInstallation, error) {
+	if r.beforeUpdate != nil {
+		r.beforeUpdate()
+	}
+	if r.current.ID != previous.ID || r.current.PluginKey != previous.PluginKey || r.current.Version != previous.Version || r.current.BinarySHA256 != previous.BinarySHA256 || r.current.ConfigEncrypted != previous.ConfigEncrypted || r.current.State == PluginStateEnabled || r.current.State == PluginStateStarting {
+		return nil, ErrPluginStateChanged
+	}
+	return r.Install(ctx, candidate, bindings)
+}
+
+func (r *pluginUpdateRepo) BeginEnableUpdate(_ context.Context, id int64, binarySHA256, expectedState, expectedVersion, expectedConfig string) error {
+	if r.current.ID != id || r.current.Version != expectedVersion || r.current.BinarySHA256 != binarySHA256 || r.current.State != expectedState || r.current.ConfigEncrypted != expectedConfig {
+		return ErrPluginStateChanged
+	}
+	r.current.State = PluginStateStarting
+	return nil
+}
+
+func (r *pluginUpdateRepo) FinishEnableUpdate(_ context.Context, previous *PluginInstallation, bindings []PluginBinding, state, lastError string, _ *time.Time) error {
+	if r.current.ID != previous.ID || r.current.Version != previous.Version || r.current.BinarySHA256 != previous.BinarySHA256 || r.current.ConfigEncrypted != previous.ConfigEncrypted || r.current.State != PluginStateStarting {
+		return ErrPluginStateChanged
+	}
+	r.current.State, r.current.LastError = state, lastError
+	if bindings != nil {
+		r.current.Bindings = append([]PluginBinding(nil), bindings...)
+	}
+	return nil
+}
+
+func (r *pluginUpdateRepo) UpdateState(_ context.Context, _ int64, state, lastError string, _ *time.Time, _, _ string) error {
+	r.current.State, r.current.LastError = state, lastError
+	return nil
+}
+
+func (r *pluginUpdateRepo) GetByID(context.Context, int64) (*PluginInstallation, error) {
+	copy := *r.current
+	copy.Bindings = append([]PluginBinding(nil), r.current.Bindings...)
+	return &copy, nil
+}
+func (r *pluginUpdateRepo) Install(_ context.Context, candidate *PluginInstallation, bindings []PluginBinding) (*PluginInstallation, error) {
+	r.installCalls++
+	if r.installErr != nil {
+		return nil, r.installErr
+	}
+	copy := *candidate
+	copy.ID, copy.ConfigEncrypted = r.current.ID, r.current.ConfigEncrypted
+	copy.Bindings = append([]PluginBinding(nil), bindings...)
+	r.current = &copy
+	return r.GetByID(context.Background(), copy.ID)
+}
+func (r *pluginUpdateRepo) UpdateBindingsAndState(_ context.Context, _ int64, bindings []PluginBinding, state, _ string, _ *time.Time, _, _ string) error {
+	r.disableCalls++
+	r.current.State = state
+	r.current.Bindings = append([]PluginBinding(nil), bindings...)
+	return nil
+}
