+  it('does not update an untested running version without separate confirmation', async () => {
+    checkUpdate.mockResolvedValue({ ...available, compatibility: { compatible: true, tested: false } })
+    vi.mocked(window.confirm).mockReturnValue(false)
+    const wrapper = await checkedUpdater()
