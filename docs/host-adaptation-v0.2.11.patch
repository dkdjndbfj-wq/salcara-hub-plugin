diff --git a/tools/export-salcara-host-licenses.mjs b/tools/export-salcara-host-licenses.mjs
new file mode 100644
--- /dev/null
+++ b/tools/export-salcara-host-licenses.mjs
@@ -0,0 +1,95 @@
+import { spawn } from 'node:child_process';
+import { cp, mkdir, readFile, readdir, stat, writeFile } from 'node:fs/promises';
+import { join } from 'node:path';
+
+// Export public dependency notices only. No credentials, caches, npmrc, env
+// files, package code, or user settings are copied into the release.
+const noticeName = /^(?:LICEN[CS]E|COPYING|COPYRIGHT|NOTICE|PATENTS|AUTHORS)(?:[._-].*)?$/i;
+const safeName = value => value.replaceAll('/', '__').replace(/[^a-zA-Z0-9_.@+-]/g, '_');
+async function run(exe, args, cwd, env = process.env) {
+  return new Promise((resolve, reject) => {
+    const child = spawn(exe, args, { cwd, env, shell: false });
+    const chunks = [], errors = [];
+    child.stdout.on('data', chunk => chunks.push(chunk));
+    child.stderr.on('data', chunk => errors.push(chunk));
+    child.on('error', reject);
+    child.on('close', code => code === 0 ? resolve(Buffer.concat(chunks).toString())
+      : reject(new Error(`Dependency license inventory failed (${exe} ${code}): ${Buffer.concat(errors).toString().slice(-2000)}`)));
+  });
+}
+async function collectNotices(root, output, prefix = '', depth = 0) {
+  const found = [];
+  for (const entry of await readdir(join(root, prefix), { withFileTypes: true })) {
+    if (entry.isSymbolicLink()) continue;
+    const path = prefix ? `${prefix}/${entry.name}` : entry.name;
+    if (entry.isFile() && noticeName.test(entry.name)) {
+      await mkdir(join(output, prefix), { recursive: true });
+      await cp(join(root, path), join(output, path));
+      found.push(path);
+    } else if (entry.isDirectory() && depth < 2 && (depth === 0 || /licen[cs]e|legal|notice/i.test(entry.name))) {
+      found.push(...await collectNotices(root, output, path, depth + 1));
+    }
+  }
+  return found.sort();
+}
+
+export async function exportHostLicenses(repo, output, go) {
+  await mkdir(output, { recursive: true });
+  const records = [];
+  const modules = new Map();
+  for (const arch of ['amd64', 'arm64']) {
+    const lines = await run(go, ['list', '-deps', '-tags=embed', '-f', '{{if .Module}}{{.Module.Path}}\t{{.Module.Version}}\t{{.Module.Dir}}{{end}}', './cmd/server'], join(repo, 'backend'), { ...process.env, CGO_ENABLED: '0', GOOS: 'linux', GOARCH: arch });
+    for (const line of lines.trim().split('\n')) {
+      const [name, version, directory] = line.trim().split('\t');
+      if (name && version && directory) modules.set(`${name}@${version}`, { name, version, directory });
+    }
+  }
+  for (const [key, module] of [...modules].sort(([a], [b]) => a.localeCompare(b))) {
+    const destination = `go/${safeName(key)}`;
+    const notices = await collectNotices(module.directory, join(output, destination));
+    records.push({ ecosystem: 'go', name: module.name, version: module.version, directory: destination, notices });
+  }
+  const goroot = (await run(go, ['env', 'GOROOT'], join(repo, 'backend'))).trim();
+  await mkdir(join(output, 'go-toolchain'), { recursive: true });
+  await cp(join(goroot, 'LICENSE'), join(output, 'go-toolchain/LICENSE'));
+  records.push({ ecosystem: 'go-toolchain', name: 'Go', version: (await run(go, ['version'], repo)).trim(), directory: 'go-toolchain', notices: ['LICENSE'] });
+
+  // pnpm's store may not have license metadata (e.g. a copied offline install),
+  // so read the actual installed package's public notices, not store internals.
+  const pnpm = join(repo, 'frontend/node_modules/.pnpm');
+  const seen = new Set();
+  async function addPackage(directory) {
+    let meta;
+    try { meta = JSON.parse(await readFile(join(directory, 'package.json'), 'utf8')); }
+    catch (error) { if (error.code === 'ENOENT') return; throw error; }
+    if (!meta.name || !meta.version) return;
+    const key = `${meta.name}@${meta.version}`;
+    if (seen.has(key)) return;
+    seen.add(key);
+    const destination = `frontend/${safeName(key)}`;
+    const notices = await collectNotices(directory, join(output, destination));
+    records.push({ ecosystem: 'npm', name: meta.name, version: meta.version, declaredLicense: meta.license ?? null, directory: destination, notices });
+  }
+  for (const store of await readdir(pnpm, { withFileTypes: true })) {
+    if (!store.isDirectory() || store.name === 'node_modules') continue;
+    const nodeModules = join(pnpm, store.name, 'node_modules');
+    let entries;
+    try { entries = await readdir(nodeModules, { withFileTypes: true }); }
+    catch (error) { if (error.code === 'ENOENT') continue; throw error; }
+    for (const entry of entries) {
+      if (!entry.isDirectory() || entry.isSymbolicLink()) continue;
+      const directory = join(nodeModules, entry.name);
+      if (entry.name.startsWith('@')) {
+        for (const scoped of await readdir(directory, { withFileTypes: true })) {
+          if (scoped.isDirectory() && !scoped.isSymbolicLink()) await addPackage(join(directory, scoped.name));
+        }
+      } else await addPackage(directory);
+    }
+  }
+  records.sort((a, b) => `${a.ecosystem}/${a.name}/${a.version}`.localeCompare(`${b.ecosystem}/${b.name}/${b.version}`));
+  await writeFile(join(output, 'dependency-notices.json'), JSON.stringify({ schema_version: 1, scope: 'Go dependencies actually selected for Linux amd64/arm64 host plus installed frontend build dependencies', dependencies: records }, null, 2) + '\n');
+  const missing = records.filter(record => record.notices.length === 0);
+  await writeFile(join(output, 'README.txt'), 'This directory contains unmodified license/notice files from the selected Go modules, Go toolchain, and installed frontend dependencies.\nThe manifest is an inventory, not a relicensing statement. Upstream package copyright and terms remain in the included files.\nFrontend inventory includes build/test dependencies as well as runtime dependencies.\nPackages with no shipped root/subtree notice file are listed in dependency-notices.json with their declared metadata; this tool does not invent license text.\n');
+  console.log(`Dependency notices exported: ${records.length} packages; ${missing.length} without shipped notice files`);
+  return records;
+}
diff --git a/tools/package-salcara-host.mjs b/tools/package-salcara-host.mjs
new file mode 100644
--- /dev/null
+++ b/tools/package-salcara-host.mjs
@@ -0,0 +1,196 @@
+import { spawn } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { cp, copyFile, mkdir, readFile, stat, writeFile } from 'node:fs/promises';
+import { dirname, isAbsolute, join, relative, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { exportHostLicenses } from './export-salcara-host-licenses.mjs';
+
+// A build/export tool, not a deployer. It never opens a config, a signing key,
+// a database, Docker socket or production endpoint. Every overlay is named.
+const repo = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const version = '0.2.11+salcara.hub.1';
+const options = process.argv.slice(2);
+function option(name) {
+  const at = options.indexOf(name);
+  return at < 0 ? undefined : options[at + 1];
+}
+const go = option('--go') || 'go';
+const output = option('--output');
+const resume = options.includes('--resume');
+if (!output || !isAbsolute(output)) throw new Error('--output must be an explicit absolute NEW directory');
+const root = resolve(output);
+if (root === repo || relative(repo, root) === '') throw new Error('Output must not be the repository root');
+try {
+  await stat(root);
+  if (!resume) throw new Error(`Refusing existing output: ${root}`);
+  // Resume only a scratch directory that this exporter already created.
+  // No directory is removed; only this build's named generated files change.
+  await stat(join(root, 'baseline-source.tar'));
+  await stat(join(root, 'source-check/backend/go.mod'));
+} catch (error) {
+  if (error.code !== 'ENOENT') throw error;
+  if (resume) throw new Error('--resume requires a previously generated scratch directory');
+}
+await mkdir(root, { recursive: true });
+
+const trackedOverlays = [
+  'backend/internal/config/config.go',
+  'backend/internal/server/router.go',
+  'backend/internal/server/routes/admin.go',
+  'backend/internal/server/routes/gateway.go',
+  'backend/internal/service/plugin_manager.go',
+  'backend/internal/service/plugin_manifest.go',
+  'backend/internal/service/plugin_package.go',
+  'backend/internal/service/plugin_package_test.go',
+  'backend/internal/service/plugin_runtime.go',
+  'backend/pkg/pluginapi/v1/manifest.schema.json',
+  'frontend/src/api/admin/plugins.ts',
+  'frontend/src/views/admin/PluginsView.vue',
+  'frontend/src/i18n/locales/zh/admin/plugins.ts',
+  'frontend/src/i18n/locales/en/admin/plugins.ts',
+];
+const newOverlays = [
+  'backend/internal/config/plugin_update_config_test.go',
+  'backend/internal/handler/admin/plugin_hub_handler.go',
+  'backend/internal/handler/admin/plugin_hub_handler_test.go',
+  'backend/internal/server/routes/plugin_hub_admin_test.go',
+  'backend/internal/service/plugin_hub.go',
+  'backend/internal/service/plugin_hub_admin_test.go',
+  'backend/internal/service/plugin_hub_integration_test.go',
+  'backend/internal/service/plugin_manifest_hub_test.go',
+  'backend/internal/service/plugin_signed_artifact_test.go',
+  'backend/internal/handler/admin/plugin_update_handler.go',
+  'backend/internal/repository/plugin_update_repo.go',
+  'backend/internal/repository/plugin_update_repo_test.go',
+  'backend/internal/handler/admin/plugin_update_handler_test.go',
+  'backend/internal/service/plugin_update.go',
+  'backend/internal/service/plugin_update_http.go',
+  'backend/internal/service/plugin_update_test.go',
+  'frontend/src/components/plugins/PluginUpdater.vue',
+  'frontend/src/components/plugins/__tests__/PluginUpdater.spec.ts',
+  'docs/SALCARA-HOST-UPGRADE.zh.md',
+  'docs/licenses/COPYING.GPL-3.0',
+  'tools/export-salcara-host-licenses.mjs',
+  'tools/package-salcara-host.mjs',
+];
+
+async function run(exe, args, settings = {}) {
+  return new Promise((done, fail) => {
+    const child = spawn(exe, args, { cwd: repo, env: process.env, shell: false, ...settings });
+    const stdout = [];
+    const stderr = [];
+    child.stdout?.on('data', data => stdout.push(data));
+    child.stderr?.on('data', data => stderr.push(data));
+    child.on('error', fail);
+    child.on('close', code => code === 0
+      ? done(Buffer.concat(stdout))
+      : fail(new Error(`${exe} exited ${code}: ${Buffer.concat(stderr).toString().slice(-4000)}`)));
+  });
+}
+async function digest(path) {
+  return createHash('sha256').update(await readFile(path)).digest('hex');
+}
+const commit = (await run('git', ['rev-parse', 'HEAD'])).toString().trim();
+if (commit !== '96f4c115c9749078f90cbf210a01d39baf3f53b6') throw new Error('Unexpected baseline; review overlays before exporting');
+const goVersion = (await run(go, ['version'])).toString().trim();
+const buildDate = new Date().toISOString();
+const docs = await readFile(join(repo, 'docs/SALCARA-HOST-UPGRADE.zh.md'));
+// A partial overlay must never silently omit a later adapter/update fix. Check
+// non-ignored source changes without scanning ignored configs or private files.
+const allowed = new Set([...trackedOverlays, ...newOverlays]);
+const trackedChanges = (await run('git', ['diff', 'HEAD', '--name-only', '-z'])).toString().split('\0').filter(Boolean);
+const addedFiles = (await run('git', ['ls-files', '--others', '--exclude-standard', '-z'])).toString().split('\0').filter(Boolean);
+for (const path of [...trackedChanges, ...addedFiles]) {
+  if (!allowed.has(path) && /^(backend|frontend)\//.test(path)) {
+    throw new Error(`Adapter source is missing from the reviewed export whitelist: ${path}`);
+  }
+}
+const frontendDist = join(repo, 'backend/internal/web/dist');
+const frontendIndex = await readFile(join(frontendDist, 'index.html'), 'utf8');
+if (!frontendIndex.includes('/assets/')) throw new Error('Build the management frontend before packaging; embedded index.html is missing');
+
+// Porting may have staged the Hub adapters; include staged and unstaged changes.
+let patch = (await run('git', ['diff', 'HEAD', '--binary', '--no-ext-diff', '--', ...trackedOverlays])).toString();
+for (const path of newOverlays) {
+  const body = (await readFile(join(repo, path), 'utf8')).replace(/\r\n/g, '\n');
+  const lines = body.endsWith('\n') ? body.slice(0, -1).split('\n') : body.split('\n');
+  patch += `diff --git a/${path} b/${path}\nnew file mode 100644\n--- /dev/null\n+++ b/${path}\n@@ -0,0 +1,${lines.length} @@\n`;
+  patch += lines.map(line => '+' + line).join('\n') + '\n';
+  if (!body.endsWith('\n')) patch += '\\ No newline at end of file\n';
+}
+await writeFile(join(root, 'host-adaptation.patch'), patch);
+await writeFile(join(root, 'README-HOST-UPGRADE.zh.md'), docs);
+const source = join(root, 'source');
+await mkdir(source, { recursive: true });
+const baseline = join(root, 'baseline-source.tar');
+await run('git', ['archive', '--format=tar', `--output=${baseline}`, 'HEAD']);
+await run('tar', ['-xf', baseline, '-C', source]);
+// No untracked repository enumeration: do not include plugins/, private keys,
+// local node_modules, environment files, build caches or personal settings.
+for (const path of [...trackedOverlays, ...newOverlays]) {
+  const destination = join(source, path);
+  await mkdir(dirname(destination), { recursive: true });
+  await copyFile(join(repo, path), destination);
+}
+await copyFile(join(root, 'host-adaptation.patch'), join(source, 'host-adaptation.patch'));
+// Compile the reviewed exported source, not the potentially larger worktree.
+// Include the exact frontend build in the source handoff as well as its Vue
+// source, so the distributable and its corresponding source are self-contained.
+await cp(frontendDist, join(source, 'backend/internal/web/dist'), { recursive: true });
+const licenses = join(root, 'THIRD-PARTY-LICENSES');
+await exportHostLicenses(repo, licenses, go);
+await cp(licenses, join(source, 'THIRD-PARTY-LICENSES'), { recursive: true });
+// A second pristine extraction makes patch applicability independently testable.
+const sourceCheck = join(root, 'source-check');
+await mkdir(sourceCheck, { recursive: true });
+await run('tar', ['-xf', baseline, '-C', sourceCheck]);
+await run('git', ['apply', '--check', join(root, 'host-adaptation.patch')], { cwd: sourceCheck });
+await run('tar', ['-czf', join(root, `sub2api-salcara-host_${version}_source.tar.gz`), '-C', source, '.']);
+const sourceArchiveSha256 = await digest(join(root, `sub2api-salcara-host_${version}_source.tar.gz`));
+
+const hashes = [];
+for (const arch of ['amd64', 'arm64']) {
+  const stage = join(root, `linux-${arch}`);
+  await mkdir(stage, { recursive: true });
+  console.log(`Building custom host linux/${arch} with embedded management UI...`);
+  await run(go, ['build', '-p=2', '-tags=embed', '-trimpath', '-buildvcs=false',
+    '-ldflags', `-s -w -X main.Version=${version} -X main.Commit=${commit.slice(0, 12)}-salcara-hub-adaptation -X main.Date=${buildDate} -X main.BuildType=source`,
+    '-o', join(stage, 'sub2api'), './cmd/server'],
+  { cwd: join(source, 'backend'), env: { ...process.env, CGO_ENABLED: '0', GOOS: 'linux', GOARCH: arch } });
+  await cp(join(source, 'backend/resources'), join(stage, 'backend/resources'), { recursive: true });
+  await mkdir(join(stage, 'deploy'), { recursive: true });
+  await copyFile(join(source, 'deploy/docker-entrypoint.sh'), join(stage, 'deploy/docker-entrypoint.sh'));
+  await copyFile(join(source, 'LICENSE'), join(stage, 'LICENSE'));
+  await copyFile(join(source, 'docs/licenses/COPYING.GPL-3.0'), join(stage, 'COPYING.GPL-3.0'));
+  await cp(licenses, join(stage, 'THIRD-PARTY-LICENSES'), { recursive: true });
+  await writeFile(join(stage, 'README-HOST-UPGRADE.zh.md'), docs);
+  const docker = await readFile(join(source, 'Dockerfile.goreleaser'), 'utf8');
+  await writeFile(join(stage, 'Dockerfile'), docker + `\nRUN chmod 0755 /app/sub2api\nLABEL org.opencontainers.image.version="${version}"\nLABEL org.opencontainers.image.description="Locally built Salcara Hub host adaptation; not an official upstream release"\nLABEL org.opencontainers.image.revision="${commit}-salcara-hub-adaptation"\n`);
+  await writeFile(join(stage, 'build-info.json'), JSON.stringify({ version, sourceCommit: commit, sourceArchiveSha256, customAdaptation: true, buildDate, goVersion, architecture: arch, platform: 'linux', cgo: false, embeddedFrontend: true, capability: 'salcara.hub.http.v1', onlineDeploymentVerified: false }, null, 2) + '\n');
+  const files = ['sub2api', 'LICENSE', 'COPYING.GPL-3.0', 'Dockerfile', 'README-HOST-UPGRADE.zh.md', 'build-info.json', 'deploy/docker-entrypoint.sh'];
+  // The fallback resource names vary by upstream baseline. Enumerate only this
+  // already-exported public resource subtree for a complete checksum list.
+  const { readdir } = await import('node:fs/promises');
+  async function resourceFiles(directory) {
+    const entries = await readdir(directory, { withFileTypes: true });
+    for (const entry of entries) {
+      const path = join(directory, entry.name);
+      if (entry.isDirectory()) await resourceFiles(path);
+      else if (entry.isFile()) files.push(relative(stage, path).replaceAll('\\', '/'));
+      else throw new Error('Unexpected non-file resource');
+    }
+  }
+  await resourceFiles(join(stage, 'backend/resources'));
+  await resourceFiles(join(stage, 'THIRD-PARTY-LICENSES'));
+  const uniqueFiles = [...new Set(files)].sort();
+  await writeFile(join(stage, 'checksums.txt'), (await Promise.all(uniqueFiles.map(async path => `${await digest(join(stage, path))}  ${path}`))).join('\n') + '\n');
+  const archive = join(root, `sub2api-salcara-host_${version}_linux_${arch}.tar.gz`);
+  await run('tar', ['-czf', archive, '-C', stage, '.']);
+  hashes.push(`${await digest(archive)}  ${relative(root, archive)}`);
+  console.log(`Packaged linux/${arch}`);
+}
+for (const path of ['host-adaptation.patch', 'README-HOST-UPGRADE.zh.md', `sub2api-salcara-host_${version}_source.tar.gz`]) {
+  hashes.push(`${await digest(join(root, path))}  ${path}`);
+}
+await writeFile(join(root, 'checksums.txt'), hashes.join('\n') + '\n');
+console.log(`Created offline host upgrade artifacts: ${root}`);
